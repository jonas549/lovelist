// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Neon con dos endpoints:
//   DATABASE_URL -> endpoint pooled (PgBouncer), lo usa la app en runtime
//   DIRECT_URL   -> endpoint directo, lo usa solo `prisma migrate`
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Sesiones de @shopify/shopify-app-react-router (PrismaSessionStorage)
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Shop {
  id              String    @id @default(cuid())
  domain          String    @unique
  currency        String?
  /// "PRO" si Shopify confirma una suscripción activa; "FREE" si confirma que
  /// no hay ninguna. Nunca se escribe a partir de una respuesta ambigua.
  plan            String    @default("FREE")
  planActivatedAt DateTime?
  /// Última vez que le preguntamos a Shopify por la suscripción. No hay
  /// webhooks de suscripción —Shopify lo dice explícitamente—, así que el
  /// sondeo es el único mecanismo y esto es lo que evita sondear de más.
  planRevisadoAt  DateTime?
  lastSyncAt      DateTime?
  settings        Json?
  /// Última vez que el storefront de esta tienda nos habló.
  ///
  /// Es como sabemos que el app embed está activo, sin pedir el scope
  /// `read_themes`: con el embed encendido, cada carga de página del
  /// storefront llama a /apps/lovelist/lists. Si hace mucho que no lo vemos,
  /// no afirmamos que esté apagado —puede que nadie haya visitado la tienda—,
  /// solo que no detectamos actividad.
  embedVistoAt    DateTime?
  /// Lo marca el webhook app/uninstalled. Se limpia solo si la tienda vuelve.
  uninstalledAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  wishlists Wishlist[]
  eventos   EventoCarrito[]
}

/// Un clic en "agregar al carrito" desde Lovelist.
///
/// NO es una conversión y no hay que llamarla así: no sabemos si la compra se
/// concretó. Saberlo pediría datos de pedidos, que son Protected Customer Data
/// y disparan un proceso de aprobación que decidimos evitar.
///
/// No se guarda quién lo hizo. Solo qué producto y cuándo: alcanza para la
/// métrica y nos mantiene sin datos personales, que es la regla del proyecto.
model EventoCarrito {
  id        String   @id @default(cuid())
  shopId    String
  /// La variante numérica que se agregó. Es lo único que el storefront sabe en
  /// ese momento: el botón lleva la variante, no el producto. Alcanza para
  /// contar, que es todo lo que esta métrica hace.
  variantId String
  creadoAt  DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, creadoAt])
}

/// Una lista de favoritos. Pertenece a un cliente registrado (customerId) o a
/// un invitado (anonymousId), nunca a los dos ni a ninguno: la migración
/// agrega un CHECK que lo obliga, porque Prisma no sabe expresar un XOR.
model Wishlist {
  id          String    @id @default(cuid())
  shopId      String
  customerId  String?
  anonymousId String?
  name        String
  isDefault   Boolean   @default(false)
  /// null hasta que el dueño pulsa "compartir". Sin token no hay link público.
  shareToken  String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  shop  Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  items WishlistItem[]

  @@index([shopId, customerId])
  @@index([shopId, anonymousId])
}

/// Solo IDs de Shopify. Nada de título, precio ni imagen: eso se lee de Shopify
/// al mostrar, para no servir precios viejos ni productos borrados.
model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  productId  String
  variantId  String?
  addedAt    DateTime @default(now())

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  /// OJO: la migración recrea este índice con NULLS NOT DISTINCT. Sin eso, en
  /// Postgres NULL != NULL y el mismo producto sin variante entraría infinitas
  /// veces, que es justo el caso del corazón en páginas de colección.
  @@unique([wishlistId, productId, variantId])
  @@index([wishlistId])
}

/// Ventana fija por identidad para limitar escrituras. Vive en Postgres porque
/// Vercel es serverless: un contador en memoria no se comparte entre instancias.
model RateLimit {
  key         String   @id
  windowStart DateTime @default(now())
  count       Int      @default(0)

  /// Para que la limpieza oportunista de ventanas vencidas no escanee la tabla.
  @@index([windowStart])
}
