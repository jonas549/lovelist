{% comment %}
  Lovelist — app embed block.

  Se activa desde el editor de temas y carga en todas las páginas. Trae el JS y
  el CSS compartidos, el contador y el drawer. El botón de la página de
  producto es un app block aparte, para que el merchant lo ponga donde quiera.

  El JS y el CSS los declara el schema (`javascript` / `stylesheet`): Shopify
  los inyecta con defer, así que no bloquean el render.

  ACÁ VIVE LA CONFIGURACIÓN. No en la base de datos: lo que el storefront
  necesita para pintarse se renderiza en Liquid y llega con la página. Sin
  red, sin parpadeo, y el merchant la edita donde ya está parado cuando coloca
  el bloque. `Shop.settings` no guarda nada de esto.

  Los colores viajan por variables CSS y no por JavaScript, a propósito: el
  bundle del storefront tiene techo y cada byte que se pueda mover a Liquid es
  un byte que no gastamos ahí.

  El bloque del botón de producto hereda todo esto sin configurarse aparte: su
  ícono lo pinta este mismo JS y sus textos salen de esta misma config.

  ---------------------------------------------------------------------------
  CUIDADO AL AGREGAR SETTINGS. Shopify limita cada bloque a **25 settings
  interactivos** (`text`, `select`, `checkbox`, `color`…) y **6 no
  interactivos** (`header`, `paragraph`). Ninguno de los dos límites está en la
  documentación y `shopify app build` no los comprueba: el único que avisa es
  `shopify app deploy`, y lo hace fallando.

  Hoy hay 24 interactivos y 5 no interactivos. Queda **un lugar de cada uno**.
  Por eso no están editables los doce textos que el comprador ve rara vez;
  está explicado en la bitácora, en "Limitaciones conocidas".
  ---------------------------------------------------------------------------

  Acá no hay ninguna referencia al dominio de la app. Todo el tráfico sale
  hacia /apps/lovelist, que es el App Proxy.
{% endcomment %}

{%- liquid
  assign apariencia = block.settings.apariencia | default: 'corazon_relleno'
  assign partes = apariencia | split: '_'
  assign forma_icono = partes[0]
  assign modo_icono = partes[1]

  assign d_guardar = 'lovelist.guardar' | t
  assign d_guardado = 'lovelist.guardado' | t
  assign d_quitar = 'lovelist.quitar' | t
  assign d_mis_favoritos = 'lovelist.misFavoritos' | t
  assign d_abrir_favoritos = 'lovelist.abrirFavoritos' | t
  assign d_cerrar = 'lovelist.cerrar' | t
  assign d_vacio = 'lovelist.vacio' | t
  assign d_vacio_ayuda = 'lovelist.vacioAyuda' | t
  assign d_cargando = 'lovelist.cargando' | t
  assign d_error_guardar = 'lovelist.errorGuardar' | t
  assign d_error_quitar = 'lovelist.errorQuitar' | t
  assign d_error_cargar = 'lovelist.errorCargar' | t
  assign d_lista_llena = 'lovelist.listaLlena' | t
  assign d_demasiado_rapido = 'lovelist.demasiadoRapido' | t
  assign d_ver_todos = 'lovelist.verTodos' | t
  assign d_agotado = 'lovelist.agotado' | t
  assign d_al_carrito = 'lovelist.alCarrito' | t
  assign d_agregar_todo = 'lovelist.agregarTodo' | t
  assign d_quitar_de_lista = 'lovelist.quitarDeLista' | t
  assign d_compartir = 'lovelist.compartir' | t
  assign d_copiar_link = 'lovelist.copiarLink' | t
  assign d_copiado = 'lovelist.copiado' | t
  assign d_por_whatsapp = 'lovelist.porWhatsapp' | t
  assign d_por_email = 'lovelist.porEmail' | t
  assign d_mensaje_compartir = 'lovelist.mensajeCompartir' | t
  assign d_asunto_email = 'lovelist.asuntoEmail' | t
  assign d_error_carrito = 'lovelist.errorCarrito' | t
  assign d_error_compartir = 'lovelist.errorCompartir' | t
  assign d_titulo_pagina = 'lovelist.tituloPagina' | t
  assign d_lista_compartida = 'lovelist.listaCompartida' | t
  assign d_solo_lectura = 'lovelist.soloLectura' | t
-%}

<style>
  /* Los valores del merchant entran acá y no por JS. Si deja uno vacío, el
     respaldo de la propia `var()` deja el aspecto de fábrica. */
  :root {
    {% if block.settings.color_inactivo != blank %}--lovelist-color-inactivo: {{ block.settings.color_inactivo }};{% endif %}
    {% if block.settings.color_activo != blank %}--lovelist-color-activo: {{ block.settings.color_activo }};{% endif %}
  }
</style>

<script type="application/json" id="lovelist-config">
  {
    "moneda": {{ shop.currency | json }},
    "idioma": {{ request.locale.iso_code | json }},
    "clienteConectado": {% if customer %}true{% else %}false{% endif %},
    "icono": {{ forma_icono | json }},
    "rellenarAlGuardar": {% if modo_icono == 'linea' %}false{% else %}true{% endif %},
    "mostrarContador": {% if block.settings.mostrar_contador == false %}false{% else %}true{% endif %},
    "claseBoton": {{ block.settings.clase_boton | default: 'button' | json }},
    "textos": {
      "guardar": {{ block.settings.texto_guardar | default: d_guardar | json }},
      "guardado": {{ block.settings.texto_guardado | default: d_guardado | json }},
      "quitar": {{ block.settings.texto_quitar | default: d_quitar | json }},
      "misFavoritos": {{ block.settings.texto_mis_favoritos | default: d_mis_favoritos | json }},
      "abrirFavoritos": {{ block.settings.texto_abrir_favoritos | default: d_abrir_favoritos | json }},
      "cerrar": {{ d_cerrar | json }},
      "vacio": {{ block.settings.texto_vacio | default: d_vacio | json }},
      "vacioAyuda": {{ block.settings.texto_vacio_ayuda | default: d_vacio_ayuda | json }},
      "cargando": {{ d_cargando | json }},
      "errorGuardar": {{ d_error_guardar | json }},
      "errorQuitar": {{ d_error_quitar | json }},
      "errorCargar": {{ d_error_cargar | json }},
      "listaLlena": {{ d_lista_llena | json }},
      "demasiadoRapido": {{ d_demasiado_rapido | json }},
      "verTodos": {{ block.settings.texto_ver_todos | default: d_ver_todos | json }},
      "agotado": {{ block.settings.texto_agotado | default: d_agotado | json }},
      "alCarrito": {{ block.settings.texto_al_carrito | default: d_al_carrito | json }},
      "agregarTodo": {{ block.settings.texto_agregar_todo | default: d_agregar_todo | json }},
      "quitarDeLista": {{ block.settings.texto_quitar_de_lista | default: d_quitar_de_lista | json }},
      "compartir": {{ block.settings.texto_compartir | default: d_compartir | json }},
      "copiarLink": {{ block.settings.texto_copiar_link | default: d_copiar_link | json }},
      "copiado": {{ d_copiado | json }},
      "porWhatsapp": {{ d_por_whatsapp | json }},
      "porEmail": {{ d_por_email | json }},
      "mensajeCompartir": {{ block.settings.texto_mensaje_compartir | default: d_mensaje_compartir | json }},
      "asuntoEmail": {{ block.settings.texto_asunto_email | default: d_asunto_email | json }},
      "errorCarrito": {{ d_error_carrito | json }},
      "errorCompartir": {{ d_error_compartir | json }},
      "tituloPagina": {{ block.settings.texto_titulo_pagina | default: d_titulo_pagina | json }},
      "listaCompartida": {{ block.settings.texto_lista_compartida | default: d_lista_compartida | json }},
      "soloLectura": {{ block.settings.texto_solo_lectura | default: d_solo_lectura | json }}
    }
  }
</script>

{% schema %}
{
  "name": "Lovelist",
  "target": "body",
  "javascript": "lovelist.js",
  "stylesheet": "lovelist.css",
  "settings": [
    {
      "type": "paragraph",
      "content": "Activá este bloque para que Lovelist funcione en toda la tienda: el contador, el panel de favoritos y los corazones en las páginas de colección. El botón de la página de producto se agrega aparte, desde el bloque \"Botón de favoritos\"."
    },
    { "type": "header", "content": "Apariencia" },
    {
      "type": "select",
      "id": "apariencia",
      "label": "Ícono",
      "info": "Sin guardar siempre se ve en línea, para que la diferencia se note sin depender del color.",
      "default": "corazon_relleno",
      "options": [
        { "value": "corazon_relleno", "label": "Corazón, se rellena al guardar" },
        { "value": "corazon_linea", "label": "Corazón, siempre en línea" },
        { "value": "estrella_relleno", "label": "Estrella, se rellena al guardar" },
        { "value": "estrella_linea", "label": "Estrella, siempre en línea" }
      ]
    },
    {
      "type": "color",
      "id": "color_activo",
      "label": "Color cuando está guardado",
      "default": "#e0245e"
    },
    {
      "type": "color",
      "id": "color_inactivo",
      "label": "Color cuando no está guardado",
      "info": "Dejalo vacío para que herede el color del texto de tu tema."
    },
    {
      "type": "checkbox",
      "id": "mostrar_contador",
      "label": "Mostrar el contador en el encabezado",
      "default": true
    },
    {
      "type": "text",
      "id": "clase_boton",
      "label": "Clase CSS de los botones de tu tema",
      "info": "Hace que los botones de Lovelist se vean como los de tu tienda. \"button\" funciona en Dawn y en la mayoría de los temas. Vacío deja el estilo propio de Lovelist.",
      "default": "button"
    },
    { "type": "header", "content": "Textos: botón y panel" },
    { "type": "text", "id": "texto_guardar", "label": "Guardar", "default": "Guardar en favoritos" },
    { "type": "text", "id": "texto_guardado", "label": "Ya guardado", "default": "Guardado en favoritos" },
    { "type": "text", "id": "texto_quitar", "label": "Quitar", "default": "Quitar de favoritos" },
    { "type": "text", "id": "texto_mis_favoritos", "label": "Título del panel", "default": "Mis favoritos" },
    { "type": "text", "id": "texto_abrir_favoritos", "label": "Abrir el panel", "default": "Abrir mis favoritos" },
    { "type": "text", "id": "texto_ver_todos", "label": "Ver todos", "default": "Ver todos mis favoritos" },
    { "type": "text", "id": "texto_vacio", "label": "Sin favoritos", "default": "Todavía no guardaste nada." },
    { "type": "text", "id": "texto_vacio_ayuda", "label": "Sin favoritos, ayuda", "default": "Tocá el corazón en cualquier producto para guardarlo acá." },
    { "type": "header", "content": "Textos: página de favoritos" },
    { "type": "text", "id": "texto_titulo_pagina", "label": "Título de la página", "info": "Es el título que ve el comprador en /apps/lovelist.", "default": "Mis favoritos" },
    { "type": "text", "id": "texto_al_carrito", "label": "Agregar al carrito", "default": "Agregar al carrito" },
    { "type": "text", "id": "texto_agregar_todo", "label": "Agregar todo", "default": "Agregar todo al carrito" },
    { "type": "text", "id": "texto_quitar_de_lista", "label": "Quitar de la lista", "default": "Quitar" },
    { "type": "text", "id": "texto_agotado", "label": "Sin stock", "default": "Sin stock" },
    { "type": "header", "content": "Textos: compartir" },
    { "type": "text", "id": "texto_compartir", "label": "Compartir", "default": "Compartir esta lista" },
    { "type": "text", "id": "texto_copiar_link", "label": "Copiar link", "default": "Copiar link" },
    { "type": "text", "id": "texto_mensaje_compartir", "label": "Mensaje al compartir", "default": "Mirá mi lista de favoritos:" },
    { "type": "text", "id": "texto_asunto_email", "label": "Asunto del email", "default": "Mi lista de favoritos" },
    { "type": "text", "id": "texto_lista_compartida", "label": "Encabezado de lista compartida", "default": "Lista compartida" },
    { "type": "text", "id": "texto_solo_lectura", "label": "Aclaración de lista compartida", "default": "Estás viendo una lista que alguien compartió con vos." }
  ]
}
{% endschema %}
