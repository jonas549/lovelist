# Copiar a .env para desarrollo local. NO commitear .env (ya está en .gitignore).

# --- Shopify ---
# En local, `shopify app dev` inyecta SHOPIFY_API_KEY / SHOPIFY_API_SECRET /
# SHOPIFY_APP_URL / SCOPES automáticamente. En Vercel hay que ponerlas a mano.
SHOPIFY_API_KEY=6b6447890b5972fb101a60cb7082e182
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://lovelist-bay.vercel.app
SCOPES=read_products

# Handle de la app, tal como aparece en la URL de la pagina de precios de
# Shopify: https://admin.shopify.com/store/{tienda}/charges/{ESTE}/pricing_plans
# Se saca del Partner Dashboard. SIN valor de reserva en el codigo a proposito:
# uno inventado daria un enlace a una pagina que no existe y el merchant no
# tendria forma de saber que el problema es de configuracion nuestra. Si falta,
# la pantalla de planes lo dice y ofrece escribir a soporte.
SHOPIFY_APP_HANDLE=

# --- Neon / Postgres ---
# DATABASE_URL: endpoint POOLED (el host lleva "-pooler"). Lo usa la app en runtime.
DATABASE_URL="postgresql://USUARIO:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"
# DIRECT_URL: endpoint DIRECTO (sin "-pooler"). Lo usa solo `prisma migrate`.
DIRECT_URL="postgresql://USUARIO:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"
